{
	"name": "void-driller",
	"version": "1.0.1",
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		".": "./server/index.js"
	},
	"description": "Retro sci-fi mining game where you pilot a modular drill rig through procedurally generated asteroids, extracting rare minerals while surviving environmental hazards and alien encounters.",
	"license": "GPL-3.0-or-later",
	"browserslist": [
		"last 1 version",
		"> 1%",
		"not dead",
		"not op_mini all"
	],
	"scripts": {
		"prepare": "bun run prepare:githooks && bun run build",
		"prepare:githooks": "[ -n \"$CI\" ] && exit 0 || (git config --local core.hooksPath .githooks || echo 'Cannot set core.hooksPath -- push checks will not run')",
		"build": "bun run build:clean && vbc-build",
		"build:clean": "rm -rf ./client/build/",
		"db:clean": "rm -f ~/.void-driller.json",
		"start": "NODE_ENV=production bun server/index.js",
		"dev": "NODE_ENV=development bun --hot server/index.js",
		"dev:clean": "bun run db:clean && bun run dev",
		"service:enable": "vbc-service enable --port 1040",
		"service:disable": "vbc-service disable",
		"service:reload": "vbc-service reload",
		"deploy": "bun run build && bun run service:reload",
		"test": "bun test",
		"lint": "bun --bun eslint",
		"lint:fix": "bun --bun eslint --fix",
		"format": "bun run lint:fix && bun --bun prettier --write .",
		"version": "npm version"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fatlard1993/void-driller.git"
	},
	"bugs": {
		"url": "https://github.com/fatlard1993/void-driller/issues"
	},
	"homepage": "https://github.com/fatlard1993/void-driller#readme",
	"dependencies": {
		"@fatlard1993/web-game-framework": "github:fatlard1993/web-game-framework#3bf1e94",
		"@vanilla-bean/components": "^7.0.1",
		"argi-cli": "^1.0.0",
		"augmented-ui": "^2.0.0",
		"emoji-js": "^3.9.0",
		"log": "github:fatlard1993/log#e0d55f6",
		"marked": "^16.4.2",
		"phaser": "^3.90.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@happy-dom/global-registrator": "^20.14.6",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"bun-types": "^1.3.14",
		"eslint": "^10.7.0",
		"eslint-plugin-compat": "^7.0.2",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^63.0.13",
		"eslint-plugin-spellcheck": "0.0.20",
		"eslint-plugin-testing-library": "^7.16.2",
		"eslint-plugin-write-good-comments": "^0.2.0",
		"globals": "^17.7.0",
		"happy-dom": "^20.14.6",
		"prettier": "^3.9.5"
	}
}
